{
  "name": "cdpi-wallet",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "build:ios:production": "eas build --platform ios --profile production",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "postinstall": "patch-package",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/__tests__/**/*.test.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@credo-ts/.*|@noble/.*|@animo-id/.*)"
    ]
  },
  "dependencies": {
    "@credo-ts/askar": "0.6.3",
    "@credo-ts/core": "0.6.3",
    "@credo-ts/openid4vc": "0.6.3",
    "@credo-ts/react-native": "0.6.3",
    "@openwallet-foundation/askar-react-native": "0.6.0",
    "@openwallet-foundation/askar-shared": "0.6.0",
    "@scure/bip39": "^2.2.0",
    "crypto-js": "^4.2.0",
    "expo": "~54.0.31",
    "expo-auth-session": "~7.0.11",
    "expo-camera": "~17.0.10",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-localization": "~17.0.8",
    "expo-mdoc-data-transfer": "^0.2.0-alpha.5",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "i18next": "^26.1.0",
    "pako": "^2.1.0",
    "react": "19.1.0",
    "react-i18next": "^17.0.7",
    "react-native": "0.81.5",
    "react-native-fs": "2.20.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.14",
    "@types/pako": "^2.0.4",
    "@types/react": "~19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.17",
    "patch-package": "^8.0.1",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@credo-ts/core": "0.6.3",
    "@credo-ts/askar": "0.6.3",
    "@credo-ts/openid4vc": "0.6.3",
    "@credo-ts/react-native": "0.6.3",
    "@openwallet-foundation/askar-shared": "0.6.0",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
