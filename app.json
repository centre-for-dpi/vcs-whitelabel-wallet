{
  "expo": {
    "name": "CDPI Wallet",
    "slug": "cdpi-wallet",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "cdpiwallet",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "bundleIdentifier": "org.cdpi.wallet",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Permite acceder a la cámara para escanear códigos QR.",
        "NSFaceIDUsageDescription": "Permite usar Face ID para proteger tu billetera.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.cdpi.wallet",
      "compileSdkVersion": 32,
      "targetSdkVersion": 32,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "openid-credential-offer"
            },
            {
              "scheme": "openid4vp"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite acceder a la cámara para escanear códigos QR."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite usar Face ID para proteger tu billetera."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "896ee82f-34f5-46cf-8d08-112b7ebaa82e"
      }
    }
  }
}