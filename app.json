{
  "expo": {
    "name": "CDPI Wallet",
    "slug": "cdpi-wallet",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "cdpiwallet",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "bundleIdentifier": "org.cdpi.wallet",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Permite acceder a la cámara para escanear códigos QR.",
        "NSFaceIDUsageDescription": "Permite usar Face ID para proteger tu billetera.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.cdpi.wallet",
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "openid-credential-offer"
            },
            {
              "scheme": "openid4vp"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "./plugins/withCleartextTraffic",
      "./plugins/withNdkVersion",
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite acceder a la cámara para escanear códigos QR."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite usar Face ID para proteger tu billetera."
        }
      ],
      "expo-web-browser",
      "expo-localization",
      [
        "expo-mdoc-data-transfer",
        {
          "bluetoothAlwaysPermission": "Permite conectar por Bluetooth para presentar tu credencial mDL a un lector.",
          "ios": {
            "buildStatic": ["MdocDataTransfer"]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 26,
            "kotlinVersion": "2.0.21"
          }
        }
      ],
      "./plugins/withMdocArchiveDedup"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "896ee82f-34f5-46cf-8d08-112b7ebaa82e"
      }
    }
  }
}
